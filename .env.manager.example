# ==============================================================================
# NOTANE MANAGER (PROVIDER LISENSI & OTA RELEASE) - KONFIGURASI DOCKER
# ==============================================================================
# Salin file ini menjadi .env.manager untuk menyesuaikan pengaturan pada VPS.
# Cara menjalankan:
#   npm run manager:up
#   atau:
#   docker compose -f docker-compose.manager.yml --env-file .env.manager up -d
# ==============================================================================

# Nama Project Docker
COMPOSE_PROJECT_NAME=notane

# Port Layanan Notane Manager Web Studio di Host VPS
# - Jika menggunakan Nginx Reverse Proxy (Aman / Hanya Localhost):
#   MANAGER_PORT=127.0.0.1:19090
# - Jika ingin dibuka langsung ke publik tanpa Nginx:
MANAGER_PORT=19090

# Domain atau URL Resmi Layanan Notane Manager
# Ini yang akan ditampilkan di panel sidebar "API Aktif" dan banner Dashboard.
# Contoh: https://lisensi.notane.id atau https://provider.domainanda.com
PROVIDER_URL=https://lisensi.notane.id

# IP / Host alternatif (opsional jika PROVIDER_URL belum diisi)
HOST_IP=

# ==============================================================================
# DATABASE POSTGRESQL (SERVER CONTAINER)
# ==============================================================================
# Port PostgreSQL host yang tidak bawaan/custom (19432) untuk mencegah bentrok
# dengan container lain atau notane-server (15432) atau default postgres (5432).
MANAGER_POSTGRES_PORT=19432
MANAGER_POSTGRES_USER=notane_manager
MANAGER_POSTGRES_PASSWORD=manager_secret_2026
MANAGER_POSTGRES_DB=notane_manager_db

# Koneksi Database URL (Default menggunakan container postgres internal di docker-compose):
# DATABASE_URL=postgres://notane_manager:manager_secret_2026@notane-manager-postgres:5432/notane_manager_db

# Jika ingin tetap menggunakan SQLite di server, kosongkan DATABASE_URL dan gunakan:
# DATABASE_PATH=/data/notane_provider.db

# ==============================================================================
# LAIN-LAIN
# ==============================================================================
# Level Log Output Rust
RUST_LOG=notane_manager=info,tower_http=info

# Master Private Key Ed25519 (Opsional - Biarkan kosong untuk menggunakan kunci default)
# PROVIDER_PRIVATE_KEY=
