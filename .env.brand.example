# ==============================================================================
# CONTOH KONFIGURASI BRAND TOKO (VPS MULTI-TENANT)
# Gandakan file ini untuk setiap brand toko yang ingin dijalankan di 1 VPS.
# Contoh nama file: brands/kopi-senja.env, brands/butik-cantika.env
# ==============================================================================

# Nama Project / Namespace Docker (Wajib Unik per Brand)
COMPOSE_PROJECT_NAME=notane-kopisenja
BRAND_NAME=Kopi Senja

# Port Server untuk Brand ini (Wajib Unik per Brand di Host VPS)
# Akses Web Manager: http://IP_VPS:18080
# Akses POS Client: http://IP_VPS:18080
SERVER_PORT=18080
CONTROL_PORT=18081

# Database PostgreSQL Terisolasi per Brand
# Port database host (opsional untuk remote admin / dbeaver, wajib unik jika diekspos)
POSTGRES_PORT=15432
POSTGRES_DB=notane_kopisenja
POSTGRES_USER=kopi_admin
POSTGRES_PASSWORD=rahasia_kopi_pos_2026

# Kode Pairing Khusus Kasir Brand Ini
PAIRING_CODE=KOPI-8899

# JWT Secret Khusus Token Autentikasi Brand Ini
JWT_SECRET=super-secret-jwt-key-kopi-senja-pos-2026

# Level Logging Rust
RUST_LOG=notane_retail_server=info,tower_http=info
