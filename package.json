{
  "name": "notane-retail-monorepo",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "workspaces": [
    "notane-client",
    "notane-server",
    "notane-manager"
  ],
  "scripts": {
    "client:dev": "npm --prefix notane-client run dev",
    "client:build": "npm --prefix notane-client run build",
    "client:app": "npm --prefix notane-client run tauri dev",
    "server:dev": "npm --prefix notane-server run dev",
    "server:build": "npm --prefix notane-server run build",
    "server:app": "npm --prefix notane-server run tauri dev",
    "server:daemon": "npm --prefix notane-server run daemon",
    "server:native": "bash ./scripts/run-server.sh riang-market",
    "manager:dev": "npm --prefix notane-manager run dev",
    "manager:build": "npm --prefix notane-manager run build",
    "manager:app": "npm --prefix notane-manager run tauri dev",
    "manager:daemon": "npm --prefix notane-manager run daemon",
    "manager:up": "docker compose -f docker-compose.manager.yml --env-file .env.manager up -d",
    "manager:down": "docker compose -f docker-compose.manager.yml --env-file .env.manager down",
    "manager:logs": "docker compose -f docker-compose.manager.yml --env-file .env.manager logs -f",
    "dev:all": "concurrently -n \"CLIENT,SERVER_UI,SERVER_CORE,MANAGER\" -c \"cyan,magenta,yellow,green\" \"npm run client:dev\" \"npm run server:dev\" \"npm run server:daemon\" \"npm run manager:dev\"",
    "build:all": "npm run client:build && npm run server:build && npm run manager:build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "setup": "bash ./scripts/setup.sh",
    "brand": "node ./scripts/brand-manager.js",
    "release": "bash ./scripts/build-release.sh",
    "release:client": "bash ./scripts/build-release.sh client",
    "release:server": "bash ./scripts/build-release.sh server",
    "release:all": "bash ./scripts/build-release.sh all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "javascript-obfuscator": "^5.9.0"
  }
}
