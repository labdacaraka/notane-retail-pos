# PostgreSQL Isolated Database Connection
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/notane_pos

# Server Port (Control Port otomatis berjalan di PORT + 1, default 18081)
PORT=18080

# Logging Level
RUST_LOG=info,notane_retail_pos=debug

# Provider Lisensi & OTA Updates (Opsional)
# - Default Production: https://lisensi.notane.id (otomatis jika baris di bawah dikomentari)
# - Pengujian Lokal dengan notane-manager: http://127.0.0.1:19090
# PROVIDER_SERVER_URL=http://127.0.0.1:19090
