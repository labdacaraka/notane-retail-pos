{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notane Retail POS",
  "version": "1.0.0",
  "identifier": "com.notane.retailpos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notane Retail POS - Enterprise Edition",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "customer-display",
        "title": "Notane - Layar Hadap Pelanggan (Customer Display)",
        "url": "/customer-display",
        "width": 1024,
        "height": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
